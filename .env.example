# Azure AI Foundry Configuration
# Copy this file to .env and fill in your values

# Your Azure AI Foundry endpoint URL
AZURE_AI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Your Azure AI Foundry API Key
AZURE_AI_API_KEY=your-api-key-here

# The deployment name for your chat model (e.g., gpt-4, gpt-35-turbo)
AZURE_AI_DEPLOYMENT=gpt-4

# Optional: Azure AI Search configuration for RAG
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-search-key-here
AZURE_SEARCH_INDEX=your-index-name
